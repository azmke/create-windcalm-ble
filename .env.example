# WindCalm BLE device configuration
#
# Copy this file to `.env` and fill in the values for your fan.
# The `.env` file is git-ignored and must never be committed.
#
# All values come from the Tuya device information (e.g. device-info.json).

# Local key (16 hex characters). This is the most sensitive value.
WIND_LOCAL_KEY=

# Tuya device ID.
WIND_DEVICE_ID=

# Internal Tuya device UUID (16 bytes).
WIND_UUID=

# Bluetooth MAC address of the fan, e.g. B8:06:0D:94:8F:85.
WIND_MAC_ADDRESS=

# Optional overrides (defaults shown).
# WIND_PRODUCT_ID=p8z27dfdwc4riyp9
# WIND_CATEGORY=fsd
# WIND_NAME=WindCalm Ceiling Fan